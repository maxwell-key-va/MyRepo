# =====================================================================
# PRE-FLIGHT VALIDATION
# =====================================================================
def validate_orders(orders: list) -> list:
    """
    Check each order for issues that would cause a mid-run handoff.
    Returns a list of (row_num, order_name, issue) tuples. Does not
    mutate orders — just reports.
    """
    problems = []
    seen_full_names = {}

    for i, o in enumerate(orders, 1):
        name = o["order_name"]
        imaging = o["imaging_type"]

        # Imaging type must be one of the known VistA menu options
        if imaging.upper() not in VALID_IMAGING_TYPES:
            problems.append((i, name, f"Unrecognized imaging_type '{imaging}' "
                              f"— must be one of: {', '.join(sorted(VALID_IMAGING_TYPES))}"))

        # Order name length: confirmed via testing that VistA's QUICK ORDER
        # NAME field has a hard 64-character limit (accepts 60, rejects 72).
        # Flag anything at or over that so it fails pre-flight instead of
        # hitting a "??" rejection mid-run.
        full_name = ORDER_PREFIX + name + ORDER_SUFFIX
        if len(full_name) >= 64:
            problems.append((i, name, f"Full order name '{full_name}' is "
                              f"{len(full_name)} chars — VistA's QUICK ORDER NAME "
                              f"field limit is 64 chars, this will be rejected."))

        # Duplicate full names would collide in VistA (second one hits
        # "Are you adding... " differently, or edits the existing order).
        if full_name in seen_full_names:
            problems.append((i, name, f"Duplicate order name '{full_name}' "
                              f"also used in row {seen_full_names[full_name]}."))
        else:
            seen_full_names[full_name] = i

        # Catch stray leading/trailing whitespace or blank fields that
        # slipped past the earlier filter (defensive, shouldn't normally fire)
        for field_name, value in (("order_name", name), ("imaging_type", imaging)):
            if value != value.strip():
                problems.append((i, name, f"Field '{field_name}' has leading/trailing whitespace: '{value}'"))

    return problems

validation_problems = validate_orders(orders)
if validation_problems:
    print(f"\n{'='*65}")
    print(f"PRE-FLIGHT VALIDATION FAILED — {len(validation_problems)} issue(s) found:")
    for row_num, name, issue in validation_problems:
        print(f"  Row {row_num:04d} [{name}]: {issue}")
    print(f"{'='*65}")
    raise ValueError("Fix the spreadsheet issues above, then re-run.")

