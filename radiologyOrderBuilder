print(f"\n{'='*65}")
print(f"COMPLETE — {len(orders)} orders processed.")
if failed:
    print(f"\nFailed orders ({len(failed)}):")
    for num, name, reason in failed:
        print(f"  {num:04d}. {name} — {reason}")
print(f"{'='*65}")
