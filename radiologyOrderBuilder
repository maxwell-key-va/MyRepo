failed = []

for i, order in enumerate(orders, 1):
    if _esc_pressed():
        _wait_for_esc_resume("Manual pause. Press ESC again to resume.")
    try:
        ok = enter_order(screen, order, i, len(orders))
        if not ok:
            failed.append((i, order["order_name"], "step sequence broke"))
    except KeyboardInterrupt:
        print("\n[ABORTED] Ctrl+C pressed.")
        break
    except Exception as exc:
        print(f"[ERROR] Order {i} '{order['order_name']}': {exc}")
        failed.append((i, order["order_name"], str(exc)))
        handoff(str(exc), order["order_name"], "Unexpected error — check VistA state.")

